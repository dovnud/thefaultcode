---
import { CONTACT_EMAIL } from '../config/site';
// Astro strips HTML comments during the build. Cloudflare email obfuscation then
// rewrites a bare mailto into /cdn-cgi/l/email-protection, which 404s. set:html
// keeps the email_off comments so the published link stays a mailto.
const html = `<!--email_off--><a href="mailto:${CONTACT_EMAIL}">${CONTACT_EMAIL}</a><!--/email_off-->`;
---
<Fragment set:html={html} />
