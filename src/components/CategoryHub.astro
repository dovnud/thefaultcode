---
import Base from '../layouts/Base.astro'; import CatIcon from './CatIcon.astro';
import { getCollection } from 'astro:content';
import { allCodes } from '../lib/paths'; import { titleCase, groupCodes, catBySlug, codePath, typeLabel } from '../config/categories';
import { fmtDate } from '../config/site';
const { cat: slug } = Astro.props; const cat = catBySlug(slug);
const groups = groupCodes(await allCodes()).filter(g => g.cat.slug === slug);
const codes = groups.flatMap(g => g.codes); const updated = codes.map(c=>c.updated).sort().pop();
const cap = (t) => t.charAt(0).toUpperCase() + t.slice(1);
const guides = (await getCollection('guides')).filter(g => g.data.category === slug).sort((a,b)=>a.data.title.localeCompare(b.data.title));
const INTRO = {
  furnaces: 'What does your furnace error code mean? These are the gas furnace flash codes and display codes from Goodman, Trane, Rheem, Carrier and Lennox manuals. Pick your brand to see what a code means, how to fix it safely and when to call a pro.',
  washers: 'What does your washing machine error code mean? These codes come from official manufacturer support documentation. Most are clearable with a drain-filter check, a hose check or a power reset. Pick your brand to see how to fix yours.',
  dishwashers: 'What does your dishwasher error code mean? These codes come from official manufacturer support documentation. Most drain, fill and sudsing codes have a safe homeowner check. Pick your brand to see how to fix yours.',
  ac: 'What does your AC or heat pump fault code mean? These outdoor-unit codes come from the manufacturer service manuals. Most need a licensed technician, so each page says which checks are safe and when to call a pro.',
};
const MORE = {
  furnaces: `The boards do not share one code language. On the Carrier 59SC5, status codes are short and long flashes of one LED: code 33 is three short and three long, and it means a limit or flame rollout switch is open. Goodman GR9S96 and GD9S96 show two characters on a 7-segment display, so EE3 is an open primary limit and E11 is an open rollout switch. Lennox ML180UH uses a red LED and a green LED together. Rheem R96V and Trane S9V2 use 7-segment displays (Rheem 33 is an open rollout switch; Trane E04 is an open limit, rollout or reverse-airflow switch). Read the pattern before you cut power. Several of these manuals also store a fault history, which a reset can clear. The longer explanations are in the furnace guides: how to read the light, how a reset actually works, what a pressure-switch code is asking the draft system to prove, and when a rollout or limit code is a reason to stop and call a technician rather than try another cycle.`,
  washers: `LG, Samsung and Whirlpool publish these codes on their own support sites, and the same letters are not a shared standard. LG OE means the washer cannot drain. Samsung 5C (also shown as 5E or nd on some models) is that brand's no-drain code, with its own rules for how far the drain hose may enter the standpipe. Whirlpool F9 E1 is a slow drain, which Whirlpool describes as drain times typically over eight minutes, and it gives a different standpipe height range. A fill code is a different fault: LG IE, Samsung 4C and Whirlpool F8 E1. Suds codes (LG Sud, Samsung SUd, Whirlpool Sud) are usually detergent, not a failed pump. Door codes (LG dE, Samsung dE, Whirlpool F5 E2) mean the washer did not lock the door. Do not mix these up with the dishwasher pages: LG and Samsung use some of the same characters on dishwashers, with different checks. Each code page links the support article it was taken from.`,
  dishwashers: `A dishwasher that stops with water in the tub is usually a drain code, a fill code, or a leak code, and the brands do not use the same letters for them. Bosch E24 is "not draining properly" and E25 is a blocked drain pump or a loose pump cover. GE C1 is a pump-out that has exceeded two minutes; GE C3 is "will not drain." LG OE is an outlet error. Samsung 5C (also 5E) is a drain error, and Samsung OC is an over-level code that Samsung troubleshoots with the same drain checks. Fill and supply codes are Bosch E16 and E17, GE H2O, LG IE and Samsung 4C, and each page lists only the checks that brand wrote down, including water-temperature ranges where the support page gives them. Leak codes are different again: Bosch E15 tells you to shut off the water and contact Bosch; LG AE and Samsung LC describe what to look at before requesting service. Use the dishwasher code page, not the washer page that happens to show the same letters.`,
  ac: `These pages cover Carrier Infinity 25VNA8 / 24VNA9 outdoor units and Goodman (Daikin) ASXC, DSXC, GSXC, ASZC, DSZC and GSZC units with the integrated control module. Carrier reports faults as short and long flashes. Code 31 is a high-pressure switch opening; if it keeps happening on the lowest stage the control elevates to lockout 84 for four hours. Code 32 is a low-pressure trip and elevates to lockout 83 after three occurrences. Goodman shows 01 or L1 for a low-pressure cutout after three trips in one thermostat call, and 02 or L2 for a high-side fault after repeated compressor-protector trips. The manuals list airflow, ice and debris on the coils among the causes a homeowner can look at. Refrigerant charge, service valves, expansion devices and line voltage are technician work. Goodman L8 is the one voltage code whose manual tells you to see whether the breaker has tripped; measuring supply voltage is still a technician step. Outdoor units stay electrically live when the thermostat is off, until the disconnect and the breaker are both off.`,
};
const hubUrl = `https://thefaultcode.com${cat.hub}`;
const jsonld = [
  {'@type':'CollectionPage','@id':`${hubUrl}#main`,name:`${cat.name} error codes`,url:hubUrl,dateModified:updated,description:INTRO[slug]},
  {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://thefaultcode.com/'},{'@type':'ListItem',position:2,name:cat.name,item:hubUrl}]},
];
---
<Base title={`${titleCase(cat.label)} Error Codes: Meanings & Fixes | The Fault Code`} description={`${codes.length} ${cat.label} error codes (${groups.map(g=>g.brand).join(', ')}): what each means, likely causes and how to fix it safely. From manufacturer manuals.`} jsonld={jsonld} updated={updated}>
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">{cat.name}</li></ol></nav>
<div class="page-h ph"><span class="ph-ic" aria-hidden="true"><CatIcon slug={slug} size={46} /></span><div class="ph-b"><p class="kicker" style="color:var(--sig-ink);margin:0">{codes.length} codes · {groups.length} brand{groups.length===1?'':'s'}</p><h1>{cap(cat.label)} error codes</h1><p>{INTRO[slug]}</p><p class="meta-l">Last updated <time datetime={updated}>{fmtDate(updated)}</time></p></div></div>
<div class="card sec"><p style="margin:0">{MORE[slug]}</p>{guides.length>0 && <p style="margin:12px 0 0">Guides for this equipment: {guides.map((g,i)=><>{i>0&&' · '}<a href={`/guides/${g.id}/`}>{g.data.title}</a></>)}. <a href="/guides/">All guides</a>.</p>}</div>
<h2 class="sr-only">Brands</h2>
<div class="grid g5">{groups.map((g,i)=><a class="card brand-card" href={g.href}><div class="tag">B-{String(i+1).padStart(2,'0')}</div><div class="bn">{g.brand}</div><div class="bc">{g.codes.length} {cat.noun} codes</div><span class="go"><span>Open code list</span><span aria-hidden="true">→</span></span></a>)}</div>
<h2 class="rel-h" style="margin-top:28px">Codes we cover</h2>
<div class="grid g3" style="margin-top:12px">{codes.map(c=><a class="card code-card" href={codePath(c)}><span class="cc">{c.code}</span><span class="cb">{c.brand} · {typeLabel(c)}</span><p class="cm">{c.meaning}</p></a>)}</div>
<p class="srcline" style="margin-top:20px"><a href={`/parts/for/${slug}/`}>Parts and tools for {cat.noun} codes</a> · Every page links its source · Last updated <time datetime={updated}>{fmtDate(updated)}</time> · <a href="/codes/">Search every category</a></p>
<div class="gasbar"><span class="w">{cat.bar[0]}</span><span>{cat.bar[1]}</span></div>
</div>
</Base>
