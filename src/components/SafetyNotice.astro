---
// Standard repair-safety notice. Plain, general text only: no credentials or guarantees are claimed.
const { kind = 'generic', inline = false } = Astro.props;
const power = kind === 'furnace' ? 'Unplug the furnace or switch it off at the breaker, and shut off the gas supply where relevant,'
  : kind === 'water-heater' ? 'Switch the water heater off at the breaker and shut off the gas supply,'
  : kind === 'washer' || kind === 'dishwasher' ? 'Unplug the appliance or switch it off at the breaker, and turn off the water supply where relevant,'
  : kind === 'ac' ? 'Switch off the indoor unit and the outdoor disconnect or breaker'
  : 'Unplug the appliance or switch off its power (and any gas or water supply) at the source';
---
{inline ? <p class="sg">Capacitors can hold a charge after the power is off. <a href="/terms/#safety">Safety terms</a>.</p>
: <div class="safety" role="note"><span class="sw" aria-hidden="true"></span><div class="st"><strong>Safety first</strong><p class="sg" style="margin:6px 0 0">{power} before you open any panel. Capacitors can hold a charge after power is off. Gas, electrical-panel, refrigerant and carbon-monoxide work belongs to a licensed professional. Follow the manual for your model (<a href="/terms/#safety">safety terms</a>).</p></div></div>}
