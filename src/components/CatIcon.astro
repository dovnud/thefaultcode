---
// Inline SVG line icons for the four equipment categories. Decorative: the adjacent text carries the meaning.
const { slug, size = 40 } = Astro.props;
---
<svg class="cat-ic" viewBox="0 0 48 48" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{slug === 'furnaces' && <><rect x="9" y="4" width="30" height="40" rx="3"/><path d="M14 11h20"/><path d="M24 38c-5.5 0-8-4-6.200-8 1.200-2.600 3.400-3.600 4-7 3 2.400 7 6.400 5.800 10.600-.7 2.600-1.800 4.400-3.600 4.400z"/></>}
{slug === 'washers' && <><rect x="8" y="4" width="32" height="40" rx="3"/><path d="M8 14h32"/><circle cx="24" cy="29" r="9.500"/><path d="M17.500 29c2.200-2.200 4.200-2.200 6.500 0s4.300 2.200 6.500 0"/><circle cx="14" cy="9" r="1.100" fill="currentColor"/><circle cx="19" cy="9" r="1.100" fill="currentColor"/></>}
{slug === 'dishwashers' && <><rect x="8" y="4" width="32" height="40" rx="3"/><path d="M8 13h32"/><path d="M17 8.500h14"/><path d="M14 36h20"/><circle cx="19" cy="26" r="5"/><circle cx="30" cy="26" r="5"/><path d="M14 36v-4M34 36v-4"/></>}
{slug === 'ac' && <><rect x="4" y="9" width="40" height="30" rx="3"/><circle cx="24" cy="24" r="10"/><path d="M24 24v-9M24 24l7.800 4.500M24 24l-7.800 4.500"/><circle cx="24" cy="24" r="1.500" fill="currentColor"/></>}
{slug === 'parts' && <><path d="M31 7a9 9 0 0 0-8.500 12L8 33.500a4 4 0 0 0 5.500 5.500L28 24.500A9 9 0 0 0 40 16l-6 3.500-4.500-1.500-1.500-4.500z"/></>}
{slug === 'guides' && <><path d="M8 8c5-2 11-2 16 2 5-4 11-4 16-2v30c-5-2-11-2-16 2-5-4-11-4-16-2z"/><path d="M24 10v30"/></>}
</svg>
