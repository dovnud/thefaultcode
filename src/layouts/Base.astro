---
import '../styles/global.css';
const { title, description, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head><body>
<a class="skip" href="#main">Skip to content</a>
<div class="topbar"><div class="wrap"><span>Free HVAC &amp; appliance error code lookup</span><a href="/#brands">Find by brand</a></div></div>
<header class="site-header"><div class="wrap"><a class="logo" href="/">The<span>Fault</span>Code</a>
<nav class="nav" aria-label="Main"><a href="/#brands">Brands</a><a href="/#popular">Popular codes</a></nav></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="wrap"><p>Information only. Follow your manufacturer's manual and local codes, and call a licensed pro for gas, electrical or refrigerant work.</p><p><a href="/">TheFaultCode.com</a></p></div></footer>
</body></html>
