---
const { title, description, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL("/og.png", Astro.site).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<style>body{font-family:system-ui,sans-serif;max-width:760px;margin:auto;padding:1rem;line-height:1.5}.warn{background:#fff3cd;padding:.5rem}.ex{background:#fdd;padding:.5rem}*{box-sizing:border-box}main,p,li,a,h1,h2{overflow-wrap:anywhere}img,svg,table,pre{max-width:100%}pre,table{overflow-x:auto;display:block}footer{margin-top:2rem;border-top:1px solid #ddd;padding-top:.5rem}footer nav a{margin-right:1rem}</style>
</head><body><header><a href="/">HVAC Error Codes</a></header><main><slot/></main><footer><nav><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/affiliate-disclosure/">Affiliate disclosure</a></nav><small>Information only; follow your manual and local codes.</small></footer></body></html>
