---
const { title, description, jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<style>body{font-family:system-ui,sans-serif;max-width:760px;margin:auto;padding:1rem;line-height:1.5}.warn{background:#fff3cd;padding:.5rem}.ex{background:#fdd;padding:.5rem}</style>
</head><body><header><a href="/">HVAC Error Codes</a></header><main><slot/></main><footer><small>Information only; follow your manual and local codes.</small></footer></body></html>
