---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { CONTACT_EMAIL } from '../config/site';
import { AMAZON_STATEMENT } from '../config/affiliates';
import { CATEGORIES, groupCodes } from '../config/categories';
import CatIcon from '../components/CatIcon.astro';
import { ogSpecs, ogPath } from '../lib/og';
const { title, description, jsonld, noindex = false, ogType = 'website', affLinks = false, amazon = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const _og = (await ogSpecs()).get(Astro.url.pathname);
const ogImg = new URL(_og ? ogPath(Astro.url.pathname) : '/og/home.png', Astro.site).href;
const ogAlt = _og?.alt ?? 'The Fault Code: furnace, washer, dishwasher and AC error codes explained';
const all = (await getCollection('codes')).filter(c=>!c.data.example);
const groups = groupCodes(all.map(c=>c.data));
const cats = CATEGORIES.filter(c=>groups.some(g=>g.cat.slug===c.slug));
const path = Astro.url.pathname;
const inCat = (c)=> c.slug==='furnaces' ? (path==='/furnaces/' || groups.some(g=>g.cat.slug==='furnaces' && path.startsWith(g.href))) : path.startsWith(c.hub);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={description}/>{noindex ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={canonical}/>}
<meta name="theme-color" content="#2a2a27"/><script is:inline>document.documentElement.classList.add("js")</script><link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/>
<meta property="og:site_name" content="The Fault Code"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={ogType}/><meta property="og:locale" content="en_US"/><meta property="og:image" content={ogImg}/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={ogAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImg}/><meta name="twitter:image:alt" content={ogAlt}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-h"><div class="wrap">
<a class="logo" href="/"><span class="logo-mark" aria-hidden="true">E-00</span><span>The Fault Code<small>Fault code field manual</small></span></a>
<button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"><span class="menu-ic" aria-hidden="true"></span><span class="menu-t">Menu</span></button>
<div class="h-right" id="site-nav">
<form class="h-search" data-search role="search" aria-label="Site search" action="/codes/" method="get"><label class="sr-only" for="hq">Search all error codes</label><input id="hq" name="q" type="search" data-search-input role="combobox" aria-expanded="false" aria-controls="hres" aria-autocomplete="list" autocomplete="off" placeholder="Search codes" /><button type="submit" aria-label="Search"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12.5 12.5L18 18" stroke="currentColor" stroke-width="2"/></svg></button><ul id="hres" class="results h-res" role="listbox" aria-label="Matching codes" hidden></ul></form>
<nav class="nav" aria-label="Main">{cats.map(c=><a href={c.hub} aria-current={path===c.hub?'page':inCat(c)?'true':undefined}>{c.nav}</a>)}<a href="/codes/" aria-current={Astro.url.pathname==='/codes/'?'page':undefined}>All codes</a><a href="/parts/" aria-current={Astro.url.pathname.startsWith('/parts/')?'true':undefined}>Parts</a><a href="/guides/" class="hi" aria-current={Astro.url.pathname.startsWith('/guides/')?'true':undefined}>Guides</a>{CONTACT_EMAIL && <a href="/contact/" class="nav-x">Contact</a>}</nav>
</div>
</div></header><div class="strip" aria-hidden="true"></div>
<main id="main"><slot/></main>
<footer class="site-f"><div class="strip" aria-hidden="true"></div><div class="wrap">
<div class="cols">
<div class="f-about"><a class="logo" href="/"><span class="logo-mark" aria-hidden="true">E-00</span><span>The Fault Code<small>Fault code field manual</small></span></a><p>Furnace, washer, dishwasher and AC error codes in plain English, taken from manufacturer manuals and official support documentation. Information only; always follow your unit's manual and local codes.</p></div>
{cats.map(c=><div class="f-cat"><h2><a href={c.hub}><CatIcon slug={c.slug} size={20} />{c.label.charAt(0).toUpperCase()+c.label.slice(1)} codes</a></h2><ul>{groups.filter(g=>g.cat.slug===c.slug).map(g=><li><a href={g.href}>{g.brand}</a></li>)}</ul></div>)}
<div class="f-site"><h2>Site</h2><ul><li><a href="/codes/">All codes</a></li><li><a href="/guides/">Guides</a></li><li><a href="/parts/">Parts and tools</a></li><li><a href="/data/">Dataset (CSV, JSON)</a></li><li><a href="/about/">About</a></li><li><a href="/privacy/">Privacy</a></li><li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li><li><a href="/terms/">Terms of Use</a></li>{CONTACT_EMAIL && <li><a href="/contact/">Contact</a></li>}</ul></div>
</div>
<div class="legal">{affLinks && <p style="margin:0 0 6px">Some links on this page are affiliate links and may earn us a commission. <a href="/affiliate-disclosure/">Learn more about our affiliate links</a>.{amazon && <>{" "}{AMAZON_STATEMENT}</>}</p>}If you smell gas, leave the building and call your gas utility from outside. For any appliance, unplug it or switch it off at the breaker before servicing. © {year} The Fault Code. Brand names are trademarks of their owners; this site is not affiliated with any manufacturer.</div>
</div></footer>
<script>
import '../scripts/search';
const mb = document.querySelector('.menu-btn'), nav = document.getElementById('site-nav');
if (mb && nav) {
  const set = (o) => { nav.classList.toggle('open', o); mb.setAttribute('aria-expanded', String(o)); };
  mb.addEventListener('click', () => set(mb.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', e => { if (e.key === 'Escape' && mb.getAttribute('aria-expanded') === 'true') { set(false); mb.focus(); } });
}
if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const go = () => import('../scripts/motion').then(m => m.start());
  'requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 2500 }) : setTimeout(go, 1200);
}
</script>
</body></html>
