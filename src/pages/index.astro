---
import Base from '../layouts/Base.astro'; import HeroGrid from '../components/HeroGrid.jsx'; import StatCounter from '../components/StatCounter.jsx'; import { getCollection } from 'astro:content';
const codes = (await getCollection('codes')).filter(c=>!c.data.example).map(c=>c.data);
const brands = [...new Map(codes.map(c=>[c.brandSlug,c.brand])).entries()].sort((a,b)=>a[1].localeCompare(b[1]));
const count = (s)=>codes.filter(c=>c.brandSlug===s).length;
const featured = brands.flatMap(([s])=>codes.filter(c=>c.brandSlug===s).slice(0,2));
featured.splice(9);
const fig = codes.find(c=>c.brandSlug==='carrier'&&c.codeSlug==='33');
const guides = (await getCollection('guides')).slice(0,3);
const jsonld={'@context':'https://schema.org','@type':'WebSite',name:'The Fault Code',url:'https://thefaultcode.com/'};
---
<Base title="The Fault Code: Furnace Error Code Lookup" description="Look up Goodman, Carrier, Trane, Lennox and Rheem furnace error codes. Plain-English meanings, likely causes and safe next steps from manufacturer manuals." jsonld={jsonld}>
<section class="hero">
<HeroGrid client:visible />
<div class="wrap">
<div>
<p class="kicker">Gas furnace fault codes · {brands.length} brands</p>
<h1>The light is blinking. <em>Here's what the board is saying.</em></h1>
<p class="lead">Type the code from your furnace's status light or display. You get the manufacturer's meaning, the likely causes, the checks that are safe for a homeowner, and the point where it becomes a job for a licensed technician.</p>
<form class="search" data-search role="search" aria-label="Code lookup" action="/codes/" method="get">
<label for="q">Code lookup</label>
<div class="box"><span class="pre" aria-hidden="true">CODE&gt;</span><input id="q" name="q" type="search" data-search-input role="combobox" aria-expanded="false" aria-controls="res" aria-autocomplete="list" autocomplete="off" enterkeyhint="search" placeholder="Brand + code, e.g. Goodman EE3" /><button class="go" type="submit">Look up</button></div>
<ul id="res" class="results" role="listbox" aria-label="Matching codes" hidden></ul>
<p class="hint">Try <a href="/carrier/33/">Carrier 33</a> · <a href="/trane/e2-1/">Trane E2.1</a> · <a href="/rheem/11/">Rheem 11</a> · <a href="/guides/how-to-read-furnace-led-flash-codes/">How to read a flash code</a></p>
</form>
<div class="stats"><div><strong><StatCounter client:visible value={codes.length} /></strong><span class="l">Codes verified</span></div><div><strong><StatCounter client:visible value={brands.length} /></strong><span class="l">Brands</span></div><div><strong>0</strong><span class="l">Guessed codes</span></div></div>
</div>
<figure class="panel" style="margin:0" aria-labelledby="fig1">
<span class="screws" aria-hidden="true"></span>
<div class="led-win" id="ledwin" data-code={fig.code}><div class="sweep" aria-hidden="true"></div><div class="led led-live" aria-hidden="true"><span class="ghost">{fig.code.replace(/[A-Za-z0-9]/g,'8')}</span>{[...fig.code].map((ch,i)=><span class={`dg d${i%4}`}>{ch}</span>)}</div><div class="led-row" aria-hidden="true"><span class="dot r" id="d-r"></span><span class="dot a" id="d-a"></span><span class="dot g on" id="d-g"></span></div></div>
<figcaption class="fig" id="fig1"><span>Fig. 01 · {fig.brand} status LED</span><a href={`/${fig.brandSlug}/${fig.codeSlug}/`}>{fig.brand} {fig.code}: {fig.meaning.split(':')[0]} →</a></figcaption>
</figure>
</div></section>
<div class="wrap">
<section class="block"><div class="sec-h"><span class="no">§01</span><h2>Browse by brand</h2><p>Each brand's codes come from one named manual, linked on every page.</p></div>
<div class="grid g5">{brands.map(([s,n],i)=><a class="card brand-card" data-reveal href={`/${s}/`}><div class="tag">B-{String(i+1).padStart(2,'0')}</div><div class="bn">{n}</div><div class="bc">{count(s)} furnace codes</div><span class="go"><span>Open code list</span><span aria-hidden="true">→</span></span></a>)}</div></section>
<section class="block"><div class="sec-h"><span class="no">§02</span><h2>Codes on file</h2><p>A sample from each brand. Search above, or browse the full list.</p></div>
<div class="grid g3">{featured.map(c=><a class="card code-card" data-reveal href={`/${c.brandSlug}/${c.codeSlug}/`}><span class="cc">{c.code}</span><span class="cb">{c.brand} · {c.equipmentType}</span><p class="cm">{c.meaning}</p></a>)}</div>
<p style="margin-top:14px"><a href="/codes/" class="btn btn-o">Browse all {codes.length} codes →</a></p></section>
<section class="block"><div class="sec-h"><span class="no">§03</span><h2>Field guides</h2><p>The questions homeowners ask most, answered from manuals and DOE, ENERGY STAR and NFPA guidance.</p></div>
<div class="grid g3">{guides.map(g=><a class="card" data-reveal href={`/guides/${g.id}/`}><div class="tag">Guide</div><h3 style="font-size:1.5rem;margin:6px 0">{g.data.title}</h3><p style="margin:0;color:var(--steel);font-size:.95rem">{g.data.description}</p></a>)}</div>
<p style="margin-top:14px"><a href="/guides/" class="btn btn-o">All guides →</a></p></section>
<section class="block"><div class="sec-h"><span class="no">§04</span><h2>How these pages are built</h2><p>Rules we follow for every code.</p></div>
<div class="trust" data-reveal>
<div><div class="n">R-01</div><h3>Manual first</h3><p>Meanings and causes come from the manufacturer's installation or service manual, and each page links to its source PDF.</p></div>
<div><div class="n">R-02</div><h3>No guessing</h3><p>If a code could not be confirmed in a manual, it is not on the site.</p></div>
<div><div class="n">R-03</div><h3>Homeowner vs. technician</h3><p>Steps are split into what a homeowner can safely check and work that needs a licensed HVAC technician.</p></div>
</div>
<div class="gasbar"><span class="w">Smell gas?</span><span>Don't touch switches or use a phone inside. Leave the building now and call your gas utility from outside.</span></div>
</section>
</div>
</script>
</Base>

<script is:inline>
(function(){
var w=document.getElementById('ledwin');if(!w)return;
if(matchMedia('(prefers-reduced-motion: reduce)').matches){document.getElementById('d-r').classList.add('on');return;}
w.classList.add('live');
var r=document.getElementById('d-r'),a=document.getElementById('d-a'),g=document.getElementById('d-g'),digs=w.querySelectorAll('.dg');
var code=w.getAttribute('data-code')||'';var m=code.match(/^(\d)(\d)$/);
var seq=m?[+m[1],+m[2]]:[3,3];
var sleep=function(t){return new Promise(function(x){setTimeout(x,t)})};
async function blink(n,idx){
 for(var i=0;i<n;i++){r.classList.add('on');if(digs[idx])digs[idx].classList.add('hot');await sleep(260);r.classList.remove('on');if(digs[idx])digs[idx].classList.remove('hot');await sleep(240);}
}
async function loop(){
 while(true){
  a.classList.add('on');await sleep(120);a.classList.remove('on');
  await blink(seq[0],0);await sleep(900);
  await blink(seq[1],1);await sleep(300);
  a.classList.add('on');await sleep(80);a.classList.remove('on');await sleep(40);a.classList.add('on');await sleep(80);a.classList.remove('on');
  await sleep(1600);
 }
}
loop();
/* random power glitch: whole display stutters and one digit drops out */
(function glitch(){
 setTimeout(function(){
  w.classList.add('glitch');
  var d=digs[Math.floor(Math.random()*digs.length)];if(d)d.classList.add('dead');
  setTimeout(function(){w.classList.remove('glitch');if(d)d.classList.remove('dead');},260+Math.random()*340);
  glitch();
 },1800+Math.random()*3200);
})();
/* green heartbeat */
setInterval(function(){g.classList.toggle('dim')},1100);
})();
</script>
