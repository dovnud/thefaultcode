---
import { ORG, SITE_URL } from '../config/site';
import { organizationLd } from '../lib/schema';
import Base from '../layouts/Base.astro'; import HeroBoard from '../components/HeroBoard.astro'; import CatIcon from '../components/CatIcon.astro'; import StatCounter from '../components/StatCounter.jsx'; import { getCollection } from 'astro:content'; import { groupCodes, CATEGORIES, codePath, typeLabel } from '../config/categories';
const codes = (await getCollection('codes')).filter(c=>!c.data.example).map(c=>c.data);
const groups = groupCodes(codes);
const brandCount = new Set(codes.map(c=>c.brandSlug)).size;
const cats = CATEGORIES.filter(c=>groups.some(g=>g.cat.slug===c.slug));
const featured = [...groups.filter(g=>g.cat.slug==='furnaces').flatMap(g=>g.codes.slice(0,1)), ...groups.filter(g=>g.cat.slug!=='furnaces').flatMap(g=>g.codes.slice(0,1))].slice(0,12);
const fig = codes.find(c=>c.brandSlug==='carrier'&&c.codeSlug==='33'&&c.equipmentType==='furnace');
const guidePick = ['how-to-read-furnace-led-flash-codes','washer-will-not-drain','dishwasher-will-not-drain','ac-high-and-low-pressure-codes','furnace-carbon-monoxide-and-rollout','washer-suds-and-detergent'];
const guideAll = await getCollection('guides');
const guides = guidePick.map(id => guideAll.find(g => g.id === id)).filter(Boolean);
const jsonld=[organizationLd(), {'@context':'https://schema.org','@type':'WebSite','@id':`${SITE_URL}/#website`,name:'The Fault Code',url:`${SITE_URL}/`,description:'Plain-English furnace, washer, dishwasher and AC / heat pump error codes, each taken from a manufacturer manual or official support page.',inLanguage:'en',publisher:{'@id':ORG['@id']}}];
---
<Base title="The Fault Code: Furnace, Washer, Dishwasher & AC Error Codes" description="Look up furnace, washer, dishwasher and AC error codes: what each code means, likely causes and how to fix it safely, from manufacturer manuals and official support pages." jsonld={jsonld}>
<section class="hero">
<div class="wrap">
<div>
<p class="kicker">Furnace · washer · dishwasher · AC fault codes · {brandCount} brands</p>
<h1>The light is blinking. <em>Here's what the board is saying.</em></h1>
<p class="lead">What does your error code mean? Type the code from your furnace, washer, dishwasher or AC unit's status light or display. You get the manufacturer's meaning, the likely causes, the checks that are safe for a homeowner, and the point where it becomes a job for a licensed technician.</p>
<form class="search" data-search role="search" aria-label="Code lookup" action="/codes/" method="get">
<label for="q">Code lookup</label>
<div class="box"><span class="pre" aria-hidden="true">CODE&gt;</span><input id="q" name="q" type="search" data-search-input role="combobox" aria-expanded="false" aria-controls="res" aria-autocomplete="list" autocomplete="off" enterkeyhint="search" placeholder="Brand + code, e.g. LG OE" /><button class="go" type="submit">Look up</button></div>
<ul id="res" class="results" role="listbox" aria-label="Matching codes" hidden></ul>
<p class="hint">Try <a href="/carrier/33/">Carrier 33</a> · <a href="/washers/lg/oe/">LG OE</a> · <a href="/dishwashers/bosch/e24/">Bosch E24</a> · <a href="/trane/e2-1/">Trane E2.1</a> · <a href="/guides/how-to-read-furnace-led-flash-codes/">How to read a flash code</a></p>
</form>
<div class="stats"><div><strong><StatCounter client:visible value={codes.length} /></strong><span class="l">Codes verified</span></div><div><strong><StatCounter client:visible value={brandCount} /></strong><span class="l">Brands</span></div><div><strong>0</strong><span class="l">Guessed codes</span></div></div>
</div>
<div class="hero-art"><HeroBoard />
<figure class="panel" style="margin:0" aria-labelledby="fig1">
<span class="screws" aria-hidden="true"></span>
<div class="led-win" id="ledwin" data-code={fig.code}><div class="sweep" aria-hidden="true"></div><div class="led led-live" aria-hidden="true"><span class="ghost">{fig.code.replace(/[A-Za-z0-9]/g,'8')}</span>{[...fig.code].map((ch,i)=><span class={`dg d${i%4}`}>{ch}</span>)}</div><div class="led-row" aria-hidden="true"><span class="dot r" id="d-r"></span><span class="dot a" id="d-a"></span><span class="dot g on" id="d-g"></span></div></div>
<figcaption class="fig" id="fig1"><span>Fig. 01 · {fig.brand} status LED</span><a href={`/${fig.brandSlug}/${fig.codeSlug}/`}>{fig.brand} {fig.code}: {fig.meaning.split(':')[0]} →</a></figcaption>
</figure></div>
</div></section>
<div class="wrap tiles-wrap"><nav class="tiles" aria-label="Pick your equipment">{cats.map(c=>{const n=groups.filter(g=>g.cat.slug===c.slug).reduce((k,g)=>k+g.codes.length,0);return <a class="tile" href={c.hub}><span class="tile-ic"><CatIcon slug={c.slug} size={44} /></span><span class="tile-t">{c.name}</span><span class="tile-s">{n} error codes</span><span class="tile-go" aria-hidden="true">→</span></a>})}</nav></div>
<div class="blocks">
<section class="block"><div class="wrap"><div class="sec-h"><span class="no">§01</span><h2>Browse by equipment and brand</h2><p>Each code comes from a named manufacturer document, linked on every page.</p></div>
{cats.map(c=>{const gs=groups.filter(g=>g.cat.slug===c.slug);return <><h3 class="cat-h"><span class="cat-ic-w"><CatIcon slug={c.slug} size={28} /></span><a href={c.hub}>{c.name}</a><small>{gs.reduce((n,g)=>n+g.codes.length,0)} codes</small></h3>
<div class="grid g5">{gs.map((g,i)=><a class="card brand-card" data-reveal href={g.href}><div class="tag">B-{String(i+1).padStart(2,'0')}</div><div class="bn">{g.brand}</div><div class="bc">{g.codes.length} {c.noun} codes</div><span class="go"><span>Open code list</span><span aria-hidden="true">→</span></span></a>)}</div></>})}</div></section>
<section class="block band"><div class="wrap"><div class="sec-h"><span class="no">§02</span><h2>Codes on file</h2><p>A sample from each equipment type and brand. Search above, or browse the full list.</p></div>
<div class="grid g3">{featured.map(c=><a class="card code-card" data-reveal href={codePath(c)}><span class="cc">{c.code}</span><span class="cb">{c.brand} · {typeLabel(c)}</span><p class="cm">{c.meaning}</p></a>)}</div>
<p style="margin-top:14px"><a href="/codes/" class="btn btn-o">Browse all {codes.length} codes →</a></p></div></section>
<section class="block"><div class="wrap"><div class="sec-h"><span class="no">§03</span><h2>Field guides</h2><p>The questions homeowners ask most, answered from manuals and DOE, ENERGY STAR and NFPA guidance.</p></div>
<div class="grid g3">{guides.map(g=><a class="card" data-reveal href={`/guides/${g.id}/`}><div class="tag">Guide</div><h3 style="font-size:1.5rem;margin:6px 0">{g.data.title}</h3><p style="margin:0;color:var(--steel);font-size:.95rem">{g.data.description}</p></a>)}</div>
<p style="margin-top:14px"><a href="/guides/" class="btn btn-o">All guides →</a></p></div></section>
<section class="block band"><div class="wrap"><div class="sec-h"><span class="no">§04</span><h2>How these pages are built</h2><p>Rules we follow for every code.</p></div>
<div class="trust" data-reveal>
<div><div class="n">R-01</div><h3>Manual first</h3><p>Meanings and causes come from the manufacturer's manual or official support page, and each page links to its source.</p></div>
<div><div class="n">R-02</div><h3>No guessing</h3><p>If a code could not be confirmed in a manual, it is not on the site.</p></div>
<div><div class="n">R-03</div><h3>Homeowner vs. technician</h3><p>Steps are split into what a homeowner can safely check and work that needs a licensed technician.</p></div>
</div>
<div class="gasbar"><span class="w">Smell gas?</span><span>Don't touch switches or use a phone inside. Leave the building now and call your gas utility from outside.</span></div>
</div></section>
</div>
</Base>

<script is:inline>
(function(){
var w=document.getElementById('ledwin');if(!w)return;
if(matchMedia('(prefers-reduced-motion: reduce)').matches){document.getElementById('d-r').classList.add('on');return;}
w.classList.add('live');
var r=document.getElementById('d-r'),a=document.getElementById('d-a'),g=document.getElementById('d-g'),digs=w.querySelectorAll('.dg');
var code=w.getAttribute('data-code')||'';var m=code.match(/^(\d)(\d)$/);
var seq=m?[+m[1],+m[2]]:[3,3];
var sleep=function(t){return new Promise(function(x){setTimeout(x,t)})};
async function blink(n,idx){
 for(var i=0;i<n;i++){r.classList.add('on');if(digs[idx])digs[idx].classList.add('hot');await sleep(260);r.classList.remove('on');if(digs[idx])digs[idx].classList.remove('hot');await sleep(240);}
}
async function loop(){
 while(true){
  a.classList.add('on');await sleep(120);a.classList.remove('on');
  await blink(seq[0],0);await sleep(900);
  await blink(seq[1],1);await sleep(300);
  a.classList.add('on');await sleep(80);a.classList.remove('on');await sleep(40);a.classList.add('on');await sleep(80);a.classList.remove('on');
  await sleep(1600);
 }
}
loop();
/* random power glitch: whole display stutters and one digit drops out */
(function glitch(){
 setTimeout(function(){
  w.classList.add('glitch');
  var d=digs[Math.floor(Math.random()*digs.length)];if(d)d.classList.add('dead');
  setTimeout(function(){w.classList.remove('glitch');if(d)d.classList.remove('dead');},260+Math.random()*340);
  glitch();
 },1800+Math.random()*3200);
})();
/* green heartbeat */
setInterval(function(){g.classList.toggle('dim')},1100);
})();
</script>
