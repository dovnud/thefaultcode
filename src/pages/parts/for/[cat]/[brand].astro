---
import Base from '../../../../layouts/Base.astro';
import { allCodes } from '../../../../lib/paths';
import { titleCase, CATEGORIES, catBySlug, groupCodes, codePath, brandPath } from '../../../../config/categories';
import { AMAZON_STATEMENT } from '../../../../config/affiliates';
import { compactLinks, usage, partUrl, partsCatUrl } from '../../../../lib/partLinks';
export async function getStaticPaths(){
  return groupCodes(await allCodes()).map(g=>({params:{cat:g.cat.slug,brand:g.brandSlug},props:{g}}));
}
const { g } = Astro.props; const cat = g.cat; const brand = g.brand;
const u = [...usage(g.codes).values()].sort((a,b)=>b.codes.length-a.codes.length);
const items = u.map(x=>({...x,links:compactLinks(x.part,brand,`${cat.slug}/${g.brandSlug}`)}));
const n = items.reduce((a,i)=>a+i.links.length,0);
const url=`https://thefaultcode.com/parts/for/${cat.slug}/${g.brandSlug}/`;
const jsonld={'@context':'https://schema.org','@type':'CollectionPage',name:`Parts and tools for ${brand} ${cat.noun} codes`,url,breadcrumb:{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://thefaultcode.com/'},{'@type':'ListItem',position:2,name:'Parts and tools',item:'https://thefaultcode.com/parts/'},{'@type':'ListItem',position:3,name:cat.name,item:`https://thefaultcode.com/parts/for/${cat.slug}/`},{'@type':'ListItem',position:4,name:brand,item:url}]}};
---
<Base title={`Parts and Tools for ${brand} ${titleCase(cat.label)} Error Codes | The Fault Code`} description={`Parts, tools and supplies named in the ${brand} ${cat.noun} manuals behind our ${g.codes.length} ${brand} code pages, with which codes mention each one.`.slice(0,300)} jsonld={jsonld} affLinks={n>0} amazon={n>0}>
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/parts/">Parts and tools</a></li><li><a href={partsCatUrl(cat.slug)}>{cat.name}</a></li><li aria-current="page">{brand}</li></ol></nav>
{n>0 && <p class="affnote">Some links on this page are affiliate links and may earn us a commission. <a href="/affiliate-disclosure/">Affiliate disclosure</a></p>}
<div class="page-h"><p class="kicker" style="color:var(--sig-ink);margin:0">{g.codes.length} {brand} codes · {items.length} guides</p><h1>Parts and tools for {brand} {cat.noun} codes</h1><p>Drawn from the causes and steps in our {g.codes.length} <a href={g.href}>{brand} {cat.noun} code pages</a>. For each part or tool you can see which {brand} codes name it. Searches that include the brand name open Amazon results and do not confirm that anything fits your model: use your model number and the part number in your manual.</p></div>
{items.map(({part,codes,links})=><section class="card sec" style="margin-top:14px"><div class="pt-kind">{part.kind} · named in {codes.length} {brand} code{codes.length===1?'':'s'}</div><h2 style="font-size:1.4rem;margin:2px 0"><a href={partUrl(part.slug)}>{part.name}</a></h2><p style="margin:4px 0">{part.summary}</p>
<div class="shoplinks">{codes.slice(0,12).map(c=><a class="btn btn-o btn-sm" href={codePath(c)}>{brand} {c.code}</a>)}</div>
{links.length>0 && <div class="shoplinks">{links.map(l=><a class={`btn btn-o btn-sm${l.kind==='asin'?' pd':''}`} rel="sponsored nofollow noopener" target="_blank" href={l.href} aria-label={`${l.kind==='asin'?'Amazon product page':'Amazon search'}: ${l.label} (sponsored link, opens in a new tab)`}>{l.kind==='asin'?'':'Search: '}{l.label}</a>)}</div>}</section>)}
{n>0 && <p class="disc">{AMAZON_STATEMENT} <a href="/affiliate-disclosure/">Affiliate disclosure</a></p>}
<p class="rel-more"><a class="btn btn-o" href={g.href}>All {brand} {cat.noun} codes →</a><a class="btn btn-o" href={partsCatUrl(cat.slug)}>Parts for all {cat.noun} brands</a></p>
<div class="gasbar"><span class="w">{cat.bar[0]}</span><span>{cat.bar[1]}</span></div>
</div></Base>
