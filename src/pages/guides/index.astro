---
import Base from '../../layouts/Base.astro'; import { getCollection } from 'astro:content';
const guides = (await getCollection('guides')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
---
<Base title="Furnace Guides | The Fault Code" description="Plain-English furnace guides: reading flash codes, resetting a furnace, short cycling, flame sensors, pressure switches and more, sourced from manufacturer manuals.">
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Guides</li></ol></nav>
<div class="page-h"><h1>Furnace guides</h1><p>Answers to common gas furnace questions, based on manufacturer manuals and government safety and energy sources.</p></div>
<div class="grid g3">{guides.map(g=><a class="card code-card" href={`/guides/${g.id}/`}><div class="cb">Guide</div><h2 style="font-size:1.1rem;margin:4px 0">{g.data.title}</h2><p class="cm">{g.data.description}</p></a>)}</div>
</div>
</Base>
