---
import Base from '../../layouts/Base.astro'; import { fmtDate, EDITORIAL } from '../../config/site'; import { AMAZON_STATEMENT, primaryShop } from '../../config/affiliates'; import { getCollection, render } from 'astro:content'; import SafetyNotice from '../../components/SafetyNotice.astro'; import CaptureForm from '../../components/CaptureForm.astro'; import { catBySlug, codePath } from '../../config/categories'; import { slugForKey, partBySlug, partUrl } from '../../lib/partLinks'; import { guideMentions } from '../../lib/guideLinks'; import { articleLd, breadcrumbLd } from '../../lib/schema';
export async function getStaticPaths(){ return (await getCollection('guides')).map(g=>({params:{slug:g.id},props:{g}})); }
const { g } = Astro.props; const d = g.data; const { Content } = await render(g);
const url = `https://thefaultcode.com/guides/${g.id}/`;
const cat = catBySlug(d.category);
const safetyKind = d.category==='furnaces'?'furnace':d.category==='washers'?'washer':d.category==='dishwashers'?'dishwasher':'ac';
const codes = (await getCollection('codes')).filter(c=>!c.data.example && guideMentions(c.data, d.codes)).map(c=>c.data);
const primary = primaryShop(d.shop ?? []);
const pg = [...new Set((d.shop??[]).map(slugForKey).filter(Boolean))].map(partBySlug).filter(Boolean);
const allGuides = await getCollection('guides');
const others = [...allGuides.filter(o=>o.id!==g.id && o.data.category===d.category), ...allGuides.filter(o=>o.id!==g.id && o.data.category!==d.category)].slice(0,6);
const jsonld = [
 articleLd({ headline: d.title, description: d.description, url, pathname: `/guides/${g.id}/`, published: d.updated, modified: d.updated }),
 ...(d.faq.length ? [{'@context':'https://schema.org','@type':'FAQPage',mainEntity:d.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}] : []),
 breadcrumbLd([{name:'Home',item:'https://thefaultcode.com/'},{name:'Guides',item:'https://thefaultcode.com/guides/'},{name:d.title,item:url}])];
---
<Base title={d.title.length>52?d.title:`${d.title} | The Fault Code`} description={d.description} jsonld={jsonld} ogType="article" affLinks={!!primary} amazon={!!primary} markdownHref={`/guides/${g.id}.md`}>
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/guides/">Guides</a></li><li aria-current="page">{d.title}</li></ol></nav>
{primary && <p class="affnote">Affiliate links may earn us a commission. {AMAZON_STATEMENT} <a href="/affiliate-disclosure/">Affiliate disclosure</a></p>}
<div class="page-h"><p class="kicker" style="color:var(--sig-ink);margin:0">Field guide</p><h1>{d.title}</h1><p class="meta-l">By {EDITORIAL} · Updated <time datetime={d.updated}>{fmtDate(d.updated)}</time></p></div>
<div class="layout"><article>
<div class="card" data-critical style="border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink)"><div class="lbl">Short answer</div><p style="font-weight:600;font-size:1.1rem;margin:6px 0 0">{d.answer}</p>
{primary && <div class="result-cta"><p class="result-cta-l">This guide names {primary.name}. The button opens an Amazon search, not a listing chosen for your model.</p><a class="btn btn-p" rel="sponsored nofollow noopener" target="_blank" href={primary.href} aria-label={`Search on Amazon: ${primary.name} (sponsored link, opens in a new tab)`}>Search on Amazon</a><p class="disc">{AMAZON_STATEMENT} <a href="/affiliate-disclosure/">Affiliate disclosure</a></p></div>}
</div>
<div class="card sec guide"><Content /></div>
<SafetyNotice kind={safetyKind} />
{g.id === 'furnace-air-filter-guide' && <CaptureForm purpose="reminder" pageUrl={`/guides/${g.id}/`} />}
<section class="card sec guide"><h2><span class="num">§F</span>FAQ</h2>{d.faq.map(f=><><h3>{f.q}</h3><p>{f.a}</p></>)}</section>
<section class="card sec guide"><h2><span class="num">§S</span>Sources</h2><ul>{d.sources.map(s=><li><a href={s.url} rel="noopener" target="_blank">{s.name}<span class="sr-only"> (opens in a new tab)</span> ↗</a></li>)}</ul></section>
</article>
<aside class="side">
{primary && <div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">Parts and filters mentioned</h2><p>Match this to your model's manual before buying.</p>
<ul class="parts"><li><span>{primary.name}</span><a class="btn btn-o btn-sm" rel="sponsored nofollow noopener" target="_blank" href={primary.href} aria-label={`Search on Amazon: ${primary.name} (sponsored link, opens in a new tab)`}>Search on Amazon</a></li></ul><p class="disc">Search on Amazon opens search results for {primary.name}. It does not confirm a fit. {AMAZON_STATEMENT}</p></div>}
{pg.length>0 && <div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">Parts and tools guides</h2><p>What each part is, how to choose and test it, and when to call a pro.</p><ul class="parts">{pg.map(x=><li><a href={partUrl(x.slug)}>{x.name}</a></li>)}<li><a href="/parts/">All parts and tools guides</a></li></ul></div>}
{codes.length>0 && <div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">Related codes</h2><ul class="parts">{codes.map(c=><li><a href={codePath(c)}>{c.brand} {c.code}</a></li>)}</ul><p style="margin:8px 0 0"><a href={cat.hub}>All {cat.name.toLowerCase()} codes</a></p></div>}
<div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">More guides</h2><ul class="parts">{others.map(o=><li><a href={`/guides/${o.id}/`}>{o.data.title}</a></li>)}</ul></div>
</aside></div>
</div>
</Base>
