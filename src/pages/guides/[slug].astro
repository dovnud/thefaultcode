---
import Base from '../../layouts/Base.astro'; import { fmtDate, ORG, EDITORIAL, EDITORIAL_AUTHOR } from '../../config/site'; import { amazonShop, AMAZON_STATEMENT } from '../../config/affiliates'; import { getCollection, render } from 'astro:content'; import SafetyNotice from '../../components/SafetyNotice.astro'; import { catOf, codePath } from '../../config/categories'; import { slugForKey, partBySlug, partUrl } from '../../lib/partLinks';
export async function getStaticPaths(){ return (await getCollection('guides')).map(g=>({params:{slug:g.id},props:{g}})); }
const { g } = Astro.props; const d = g.data; const { Content } = await render(g);
const url = `https://thefaultcode.com/guides/${g.id}/`;
const codes = (await getCollection('codes')).filter(c=>!c.data.example && d.codes.includes(`${c.data.brandSlug}/${c.data.codeSlug}`) && catOf(c.data).slug==='furnaces').map(c=>c.data);
const shop = amazonShop(d.shop);
const pg = [...new Set((d.shop??[]).map(slugForKey).filter(Boolean))].map(partBySlug).filter(Boolean);
const others = (await getCollection('guides')).filter(o=>o.id!==g.id).slice(0,4);
const jsonld = [
 {'@context':'https://schema.org','@type':'Article',headline:d.title,description:d.description,dateModified:d.updated,author:EDITORIAL_AUTHOR,publisher:ORG,mainEntityOfPage:url},
 {'@context':'https://schema.org','@type':'FAQPage',mainEntity:d.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},
 {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://thefaultcode.com/'},{'@type':'ListItem',position:2,name:'Guides',item:'https://thefaultcode.com/guides/'},{'@type':'ListItem',position:3,name:d.title,item:url}]}];
---
<Base title={d.title.length>52?d.title:`${d.title} | The Fault Code`} description={d.description} jsonld={jsonld} ogType="article" affLinks={shop.length>0} amazon={shop.length>0}>
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/guides/">Guides</a></li><li aria-current="page">{d.title}</li></ol></nav>
{shop.length>0 && <p class="affnote">Some links on this page are affiliate links and may earn us a commission. {AMAZON_STATEMENT} <a href="/affiliate-disclosure/">Affiliate disclosure</a></p>}
<div class="page-h"><p class="kicker" style="color:var(--sig-ink);margin:0">Field guide</p><h1>{d.title}</h1><p class="meta-l">By {EDITORIAL} · Updated <time datetime={d.updated}>{fmtDate(d.updated)}</time></p></div>
<div class="layout"><article>
<div class="card" data-critical style="border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink)"><div class="lbl">Short answer</div><p style="font-weight:600;font-size:1.1rem;margin:6px 0 0">{d.answer}</p></div>
<div class="card sec guide"><Content /></div>
<SafetyNotice kind="furnace" />
<section class="card sec guide"><h2><span class="num">§F</span>FAQ</h2>{d.faq.map(f=><><h3>{f.q}</h3><p>{f.a}</p></>)}</section>
<section class="card sec guide"><h2><span class="num">§S</span>Sources</h2><ul>{d.sources.map(s=><li><a href={s.url} rel="noopener" target="_blank">{s.name}<span class="sr-only"> (opens in a new tab)</span> ↗</a></li>)}</ul></section>
</article>
<aside class="side">
{shop.length>0 && <div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">Parts and filters mentioned</h2><p>Parts and supplies this guide discusses. Match any part to your model's manual before buying.</p>
<ul class="parts">{shop.map(p=><li><span>{p.name}</span><a class="btn btn-o btn-sm" rel="sponsored nofollow noopener" target="_blank" href={p.href} aria-label={`Shop on Amazon: ${p.name} (sponsored link, opens in a new tab)`}>Shop on Amazon</a></li>)}</ul><p class="disc">Shop links open Amazon search results for the part name. {AMAZON_STATEMENT}</p></div>}
{pg.length>0 && <div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">Parts and tools guides</h2><p>What each part is, how to choose and test it, and when to call a pro.</p><ul class="parts">{pg.map(x=><li><a href={partUrl(x.slug)}>{x.name}</a></li>)}<li><a href="/parts/">All parts and tools guides</a></li></ul></div>}
{codes.length>0 && <div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">Related codes</h2><ul class="parts">{codes.map(c=><li><a href={codePath(c)}>{c.brand} {c.code}</a></li>)}</ul></div>}
<div class="card box"><h2 style="font-size:1.35rem;margin:0 0 6px">More guides</h2><ul class="parts">{others.map(o=><li><a href={`/guides/${o.id}/`}>{o.data.title}</a></li>)}</ul></div>
</aside></div>
</div>
</Base>
