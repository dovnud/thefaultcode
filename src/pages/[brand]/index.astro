---
import Base from '../../layouts/Base.astro'; import { fmtDate } from '../../config/site'; import { getCollection } from 'astro:content'; import { amazonShop, AMAZON_STATEMENT } from '../../config/affiliates';
export async function getStaticPaths(){ const all=(await getCollection('codes')).filter(c=>!c.data.example);
  const slugs=[...new Set(all.map(c=>c.data.brandSlug))];
  return slugs.map(s=>({params:{brand:s},props:{codes:all.filter(c=>c.data.brandSlug===s).map(c=>c.data)}})); }
const { codes } = Astro.props; const updated=[...codes.map(c=>c.updated)].sort().pop(); const brand = codes[0].brand; const src = codes[0].sourceManualUrl;
const shop = amazonShop(codes.flatMap(c=>c.parts.map(p=>p.partKey)));
const jsonld={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://thefaultcode.com/'},{'@type':'ListItem',position:2,name:brand,item:`https://thefaultcode.com/${codes[0].brandSlug}/`}]};
---
<Base title={`${brand} Furnace Error Codes | The Fault Code`} description={`All ${codes.length} ${brand} furnace error and flash codes we cover, with meanings from the manufacturer manual.`} jsonld={jsonld} affLinks={shop.length>0} amazon={shop.length>0}>
<div class="wrap">
<nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">{brand}</li></ol></nav>
<div class="page-h"><p class="kicker" style="color:var(--sig-ink);margin:0">Code index · {codes.length} entries</p><h1>{brand} furnace error codes</h1><p>{codes.length} codes from the {brand} furnace manual. Select a code for causes, safe checks and when to call a pro.{src && <> <a href={src} rel="noopener" target="_blank">View the source manual (PDF)<span class="sr-only"> (opens in a new tab)</span> ↗</a>.</>}</p></div>
<form class="filter-row" role="search" aria-label={`Filter ${brand} codes`}><label class="sr-only" for="f">Filter {brand} codes</label><input class="filter" id="f" data-filter type="search" autocomplete="off" placeholder={`Filter ${brand} codes, e.g. flame or 33`} /><span class="count" id="f-count" role="status" aria-live="polite">{codes.length} codes</span></form>
<div class="grid g3" id="g" style="margin-top:18px">{codes.map(c=><a class="card code-card" href={`/${c.brandSlug}/${c.codeSlug}/`} data-s={`${c.brand} ${c.code} ${c.meaning} ${c.equipmentType}`.toLowerCase()}><span class="cc">{c.code}</span><span class="cb">{c.equipmentType}</span><p class="cm">{c.meaning}</p><div class="badges">{c.proNeeded?<span class="badge b-pro">Call a pro</span>:<span class="badge b-diy">Basic checks first</span>}</div></a>)}</div>
<div class="f-empty" id="f-empty" hidden><strong>No {brand} code matches that.</strong> <span>Clear the filter, or <a href="/codes/">search every brand</a>.</span></div>
{shop.length>0 && <section class="card box" aria-labelledby="shop-h" style="margin-top:20px"><h2 id="shop-h" style="font-size:1.35rem;margin:0 0 6px">Parts named in {brand} codes</h2><p>Parts the {brand} codes above point to. Check your model's manual before buying, and leave gas and venting work to a licensed pro.</p>
<ul class="parts">{shop.map(p=><li><span>{p.name}</span><a class="btn btn-o btn-sm" rel="sponsored nofollow noopener" target="_blank" href={p.href} aria-label={`Shop on Amazon: ${p.name} (sponsored link, opens in a new tab)`}>Shop on Amazon</a></li>)}</ul><p class="disc">Shop links open Amazon search results for the part name. {AMAZON_STATEMENT}</p></section>}
<p class="srcline" style="margin-top:20px">Source: {src ? <a href={src} rel="noopener" target="_blank">{brand} manual (PDF)<span class="sr-only"> (opens in a new tab)</span> ↗</a> : `${brand} manual`} · Updated <time datetime={updated}>{fmtDate(updated)}</time></p>
<div class="gasbar"><span class="w">Smell gas?</span><span>If you smell gas, leave the building and call your gas utility from outside.</span></div>
</div>
<script>import '../../scripts/filter';</script>
</Base>
